{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "SVELTEKIT_OUT_DIR=.svelte-kit-build vite build",
		"preview": "SVELTEKIT_OUT_DIR=.svelte-kit-build vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "SVELTEKIT_OUT_DIR=.svelte-kit-check svelte-kit sync && SVELTEKIT_OUT_DIR=.svelte-kit-check svelte-check --tsconfig ./tsconfig.check.json",
		"check:watch": "SVELTEKIT_OUT_DIR=.svelte-kit-check svelte-kit sync && SVELTEKIT_OUT_DIR=.svelte-kit-check svelte-check --tsconfig ./tsconfig.check.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.73.0",
		"@sveltejs/adapter-auto": "^4.0.0",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@tailwindcss/vite": "^4.3.5",
		"bits-ui": "^2.21.0",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.20.0",
		"vite": "^6.0.0"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.7.0",
		"zod": "^3.24.2"
	}
}
